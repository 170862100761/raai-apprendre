# Copier en .env.local et remplir. Aucune valeur réelle dans le dépôt.
#
# Règle contrôlée en CI (voir src/noyau/environnement.ts) : aucune variable
# contenant KEY, SECRET ou TOKEN ne peut être préfixée NEXT_PUBLIC_.
# Une clé exposée au navigateur est publique dès le premier chargement.

# --- Base de données -------------------------------------------------------
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/raai?schema=raai_apprendre"
DIRECT_URL="postgresql://postgres:motdepasse@localhost:5432/raai?schema=raai_apprendre"

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Redis (Upstash) -------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- IA — serveur uniquement, sans exception -------------------------------
IA_FOURNISSEUR_DEFAUT="claude"
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENAI_API_KEY=""
MISTRAL_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# --- Services --------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
SENTRY_DSN=""

# --- Application -----------------------------------------------------------
NEXT_PUBLIC_URL_SITE="http://localhost:3000"
# Signature des jetons de session apprenant (mode minimal). 32 octets minimum.
SECRET_SESSION_APPRENANT=""
